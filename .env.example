# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# STAFF_PASSCODE: Optional shared staff passcode for Receptionist, Doctor, and Admin consoles.
# If left unset, an inline first-run setup lets you claim the hospital staff passcode in the UI.
STAFF_PASSCODE=

# SESSION_SECRET: Secret used to sign staff session bearer tokens (defaults to random in-memory key if unset).
SESSION_SECRET=

# N8N_WEBHOOK_URL: Optional n8n webhook URL to dispatch appointment and 30-min reminder events.
N8N_WEBHOOK_URL=

# OPENWA_WEBHOOK_SECRET: Optional shared secret header (x-openwa-secret) for external OpenWA bridge webhooks.
OPENWA_WEBHOOK_SECRET=
